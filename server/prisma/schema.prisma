generator client {
  provider      = "prisma-client-js"
  // native = your machine, rhel-openssl-3.0.x = Vercel's serverless runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name     String
  email    String @unique
  password String

  role UserRole @default(USER)

  memberships      MessMember[]
  invitationsSent  Invitation[]
  meals            Meal[]
  expensesRecorded Expense[]    @relation("ExpenseRecorder")
  expensesPaid     Expense[]    @relation("ExpensePayer")
  deposits         Deposit[]    @relation("DepositOwner")
  depositsRecorded Deposit[]    @relation("DepositRecorder")
  settlements      Settlement[]

  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  USER
}

model Mess {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name        String
  description String?
  address     String?

  memberships  MessMember[]
  invitations  Invitation[]
  meals        Meal[]
  expenses     Expense[]
  deposits     Deposit[]
  monthlyBills MonthlyBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MessRole {
  MANAGER
  MEMBER
}

model MessMember {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  messId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])
  mess Mess @relation(fields: [messId], references: [id])

  role MessRole @default(MEMBER)

  // Fixed monthly room rent this member pays (rooms can differ in price)
  rentAmount Float @default(0)

  // Members who leave are deactivated, not deleted, so past months still add up
  isActive Boolean   @default(true)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, messId])
  @@index([messId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Invitation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  messId    String @db.ObjectId
  invitedBy String @db.ObjectId

  email  String
  token  String           @unique
  status InvitationStatus @default(PENDING)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mess    Mess @relation(fields: [messId], references: [id])
  inviter User @relation(fields: [invitedBy], references: [id])

  @@index([messId])
  @@index([email])
}

// One row per member per day. `count` is the number of meals eaten that day
// (half meals allowed, e.g. 2.5).
model Meal {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  messId String @db.ObjectId

  // Calendar day, stored as UTC midnight
  date  DateTime
  count Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  mess Mess @relation(fields: [messId], references: [id])

  @@unique([messId, userId, date])
  @@index([messId, date])
}

// MEAL  = bazar/groceries; divided by total meals to get the meal rate
// HOUSE = shared house bills (wifi, electricity, gas, water, maid, ...);
//         split equally among members, or by custom shares
enum ExpenseKind {
  MEAL
  HOUSE
}

enum ExpenseCategory {
  BAZAR
  ELECTRICITY
  GAS
  WATER
  INTERNET
  MAID
  SERVICE
  OTHER
}

type ExpenseShare {
  userId String @db.ObjectId
  amount Float
}

model Expense {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  messId     String  @db.ObjectId
  recordedBy String  @db.ObjectId
  // Member who paid out of their own pocket (credited to them).
  // null = paid from the mess fund (deposits).
  paidById   String? @db.ObjectId

  kind        ExpenseKind
  category    ExpenseCategory
  title       String
  description String?
  amount      Float
  // Calendar day, stored as UTC midnight
  date        DateTime

  // HOUSE only. Empty = split equally among all members of the month.
  shares ExpenseShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mess     Mess  @relation(fields: [messId], references: [id])
  recorder User  @relation("ExpenseRecorder", fields: [recordedBy], references: [id])
  paidBy   User? @relation("ExpensePayer", fields: [paidById], references: [id])

  @@index([messId, date])
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
  BANK
  OTHER
}

// Money a member hands to the manager, counted against a specific month.
model Deposit {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  messId     String @db.ObjectId
  userId     String @db.ObjectId
  recordedBy String @db.ObjectId

  amount Float
  method PaymentMethod @default(CASH)
  note   String?
  // Calendar day the money was received, stored as UTC midnight
  date   DateTime
  // The month this deposit settles
  month  Int
  year   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mess     Mess @relation(fields: [messId], references: [id])
  user     User @relation("DepositOwner", fields: [userId], references: [id])
  recorder User @relation("DepositRecorder", fields: [recordedBy], references: [id])

  @@index([messId, year, month])
  @@index([userId])
}

// A closed (locked) month. Open months have no row and are calculated live.
model MonthlyBill {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  messId String @db.ObjectId

  month Int
  year  Int

  totalMeals   Float @default(0)
  mealExpense  Float @default(0)
  mealRate     Float @default(0)
  houseExpense Float @default(0)
  totalRent    Float @default(0)

  closedBy String   @db.ObjectId
  closedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mess        Mess         @relation(fields: [messId], references: [id])
  settlements Settlement[]

  @@unique([messId, month, year])
}

// Per-member charges frozen when a month is closed.
// Deposits are not frozen: members can still pay off a closed month.
model Settlement {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  billId String @db.ObjectId
  userId String @db.ObjectId

  mealCount     Float @default(0)
  mealCost      Float @default(0)
  rent          Float @default(0)
  houseShare    Float @default(0)
  totalCharge   Float @default(0)
  // Bazar / bills this member paid out of pocket
  expenseCredit Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bill MonthlyBill @relation(fields: [billId], references: [id])
  user User        @relation(fields: [userId], references: [id])

  @@unique([billId, userId])
  @@index([userId])
}

model RefreshToken {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId    String @db.ObjectId
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId    String @db.ObjectId
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}
